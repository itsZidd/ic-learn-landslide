# =================================================================
# I-CARE LANDSLIDE LEARNING - ENVIRONMENT VARIABLES CONFIGURATION
# =================================================================
# Copy this file to '.env' for local development or set these variables
# in your deployment platform settings (Vercel / Netlify / Cloudflare / etc).

# -----------------------------------------------------------------
# 1. BETTER AUTH SECRET
# -----------------------------------------------------------------
# A random 32+ character secret string used to sign session tokens & cookies.
# You can generate a new key using PowerShell/Bash:
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Min 0 -Max 256 }))
# Or node command:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="icare-landslide-learning-um-2026-secret-key-change-this-32chars"

# Base URL of your deployed SvelteKit application (optional for local dev)
BETTER_AUTH_URL="http://localhost:5173"

# -----------------------------------------------------------------
# 2. TURSO EDGE SQLITE DATABASE CONFIGURATION
# -----------------------------------------------------------------
# Leave blank for local development to use local file:local.db automatically.
# For production Turso hosted database, get credentials from Turso CLI:
#   1. Get Database URL:   turso db show <your-db-name> --url
#   2. Create Auth Token:  turso db tokens create <your-db-name>

TURSO_DATABASE_URL="libsql://your-database-name-username.turso.io"
TURSO_AUTH_TOKEN="your-turso-jwt-auth-token-here"

# -----------------------------------------------------------------
# 3. GOOGLE OAUTH CONFIGURATION (OPTIONAL - FOR FUTURE GOOGLE LOGIN)
# -----------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Credentials:
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# -----------------------------------------------------------------
# 4. GEMINI API KEY (REQUIRED FOR AI ESSAY EVALUATION)
# -----------------------------------------------------------------
# Without this, the Reflection essay grader silently falls back to a local
# keyword-matching rubric instead of actually calling Gemini.
# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
